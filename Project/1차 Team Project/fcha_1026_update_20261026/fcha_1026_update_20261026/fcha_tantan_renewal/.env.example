# .env.example → .env 로 복사한 뒤 값을 채우세요. .env는 Git·ZIP에 넣지 않습니다.

# Django (배포 시 필수)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# 관리자 계정 (scripts/create_admin.py가 읽습니다. 첫 로그인 후 /admin/ 에서 비밀번호를 바꾸세요)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# 메일 발송(회원가입 이메일 인증번호). 비워두면 메일 대신 서버 콘솔(검은 창)에 인증번호가 출력됩니다.
# 예) 네이버 메일: smtp.naver.com / 587 / 아이디@naver.com / 앱 비밀번호   ·  Gmail: smtp.gmail.com / 587 / 앱 비밀번호
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# 간편로그인 — 각 개발자센터에서 앱 등록 후 발급
# 콜백(Redirect URI): http://127.0.0.1:8000/oauth/naver/login/callback/
#                     http://127.0.0.1:8000/oauth/kakao/login/callback/
#                     http://127.0.0.1:8000/oauth/google/login/callback/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 지도 JavaScript 키 (매장 위치 지도). 카카오 개발자센터 › 플랫폼 › Web 에 http://127.0.0.1:8000 등록 필요
KAKAO_JS_KEY=
